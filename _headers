# Cloudflare Pages headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# HTML: always revalidate (avoid extra bytes per visit)
/
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/**/*.html
  Cache-Control: no-cache

# “Pretty URL” routes that map to index.html
/*/
  Cache-Control: no-cache

/*/*/
  Cache-Control: no-cache

/*/*/*/
  Cache-Control: no-cache

/*/*/*/*/
  Cache-Control: no-cache

# Versioned static assets (fingerprinted filename like app.abc123.js)
/*.*.*
  Cache-Control: public, max-age=31536000, immutable

/*/*.*.*
  Cache-Control: public, max-age=31536000, immutable

/*/*/*.*.*
  Cache-Control: public, max-age=31536000, immutable

/*/*/*/*.*.*
  Cache-Control: public, max-age=31536000, immutable

